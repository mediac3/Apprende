// Aulnea — Plataforma educativa modular
// Schema: instituciones, usuarios, módulos académicos, convivencia, comunidad

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institution {
  id            String   @id @default(cuid())
  name          String
  shortName     String?
  nit           String?
  dane          String?
  logoUrl       String?
  address       String?
  phone         String?
  email         String?
  academicYear  String   @default("2025")
  resolution    String?  // Resolución de aprobación (PDF pág 13)
  city          String?  // Ciudad (PDF pág 13)
  icfesCode     String?  // Código ICFES (PDF pág 13)
  decree        String?  // Decreto (PDF pág 2 - tabla años)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  roles         Role[]
  spaces        Space[]
  posts         Post[]
  students      Student[]
  groups        Group[]
  subjects      Subject[]
  periods       Period[]
  meetings      Meeting[]
  enrollments   Enrollment[]
  audits        AuditLog[]
  customModules CustomModule[]
  customRecords CustomModuleRecord[]
  branches      Branch[]
  journeys      Journey[]
  evalScales    EvaluationScale[]
  evalModels    EvaluationModel[]
  reportTemplates ReportTemplate[]
  academicYears AcademicYear[]
  knowledgeAreas  KnowledgeArea[]
  gradeLevels     GradeLevel[]
  curriculumPlans CurriculumPlan[]
  studentEnrollments   StudentEnrollment[]
  studentContacts      StudentContact[]
  studentRequirements  StudentRequirement[]
  externalCertificates ExternalCertificate[]
  educationalModels    EducationalModel[]
  evaluativeConcepts   EvaluativeConcept[]
  activities           Activity[]
}

// UserRole (códigos del catálogo Role): rector, coordinador, director_grupo,
// docente, orientador, acudiente, estudiante, administrativo + roles adicionales
// del módulo de usuarios (tesoreria, asistente_matricula, tercero...).
// User.role conserva el rol principal (menor sortOrder) sincronizado desde
// UserRole para compatibilidad con la sesión y el filtrado del menú.

model User {
  id              String   @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  username        String   @unique
  email           String?
  phone           String?
  passwordHash    String
  fullName        String
  role            String   @default("docente") // rol principal (sincronizado desde UserRole)
  avatarUrl       String?
  jobTitle        String?
  active          Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts           Post[]
  comments        Comment[]
  reactions       Reaction[]
  messagesSent    Message[]       @relation("MessageSender")
  messagesReceived Message[]      @relation("MessageReceiver")
  notifications   Notification[]
  audits          AuditLog[]
  grades          Grade[]         @relation("GradeTeacher")
  attendances     Attendance[]
  observations    Observation[]
  meetings        MeetingSigner[]
  orientations    Orientation[]
  badges          UserBadge[]
  syncOps         SyncOp[]
  enrollments     Enrollment[]    @relation("ProcessedBy")
  assignments     SubjectAssignment[] @relation("Teacher")
  spaceMemberships SpaceMember[]
  headedGroups    Group[]             @relation("GroupHeadTeacher")
  userRoles       UserRole[]
}

model Group {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // e.g. "8°A"
  section       String?
  headTeacherId String?  // director de grupo
  createdAt     DateTime @default(now())

  gradeLevelId  String?  // grado (catálogo GradeLevel)
  gradeLevel    GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  headTeacher   User?    @relation("GroupHeadTeacher", fields: [headTeacherId], references: [id], onDelete: SetNull)

  // Gestión de Grupos (PDF Módulo Grupos) — FKs a catálogos existentes (sin redundancia)
  academicYearId String?  // año académico (catálogo AcademicYear)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  branchId       String?  // sede (catálogo Branch)
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  journeyId      String?  // jornada (catálogo Journey)
  journey        Journey? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  students      Student[]
  assignments   SubjectAssignment[]
  attendances   Attendance[]
  studentEnrollments StudentEnrollment[] // Gestión de Estudiantes (matrícula por año)
  activities      Activity[] // Módulo Calificaciones
}

model Student {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  code          String   // código institucional
  firstName     String
  lastName      String
  birthDate     DateTime?
  gender        String?
  address       String?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  guardianRelation String?
  status        String   @default("activo") // activo, retirado, suspendido
  enrollmentDate DateTime?
  // Gestión de Estudiantes (PDF Módulo Gestionar Estudiante) — columnas aditivas
  documentType    String?  // RC, TI, CC, CE, PE
  documentNumber  String?  // número de documento (T.I.)
  birthPlace      String?  // lugar de nacimiento (PDF pág 10)
  baptized        Boolean? // BAP: certificado de bautismo presentado (PDF pág 3)
  overage         Boolean? // EX/ED: extraedad (PDF pág 3)
  photoUrl        String?  // foto del estudiante (data URL, PDF pág 9)
  identityDocUrl  String?  // documento de identidad (data URL, PDF pág 9)
  // Datos SIMAT (PDF pág 10)
  simatEstrato       String? // 1-6
  simatEps           String? // entidad promotora de salud
  simatMunicipioExp  String? // municipio de expedición del documento
  createdAt      DateTime @default(now())

  grades        Grade[]
  attendances   Attendance[]
  observations  Observation[]
  orientations  Orientation[]
  enrollments        StudentEnrollment[]
  contacts           StudentContact[]
  requirements       StudentRequirement[]
  externalCertificates ExternalCertificate[]
  gradeRecords       GradeRecord[] // Módulo Calificaciones
}

model Subject {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  abbreviation  String?  // Abreviatura (PDF pág 3-4)
  averages      Boolean  @default(true)  // Promedia (PDF pág 3-4) - si cuenta para el promedio
  active        Boolean  @default(true)  // Estado (PDF pág 3-4)
  percentage    Int      @default(0)     // % absoluto dentro del área (0-100; hijas de un área suman 100)
  createdAt     DateTime @default(now())

  areaId        String?  // área del conocimiento (catálogo KnowledgeArea)
  area          KnowledgeArea? @relation("SubjectArea", fields: [areaId], references: [id], onDelete: SetNull)
  assignments   SubjectAssignment[]
  grades        Grade[]
  workshops     Workshop[]
  planItems     CurriculumPlanItem[]
  activities    Activity[] // Módulo Calificaciones
}

model SubjectAssignment {
  id            String   @id @default(cuid())
  institutionId String
  groupId       String
  subjectId     String
  teacherId     String?
  weeklyHours   Int      @default(1)
  createdAt     DateTime @default(now())

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       User?    @relation("Teacher", fields: [teacherId], references: [id], onDelete: SetNull)
}

model Period {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // Periodo 1, 2, 3, 4
  startDate     DateTime
  endDate       DateTime
  weight        Float    @default(25) // porcentaje
  active        Boolean  @default(false)
  closed        Boolean  @default(false)
  createdAt     DateTime @default(now())
  educationalModelId String?
  educationalModel EducationalModel? @relation(fields: [educationalModelId], references: [id], onDelete: SetNull)
  order         Int?     // posición dentro del modelo educativo (1..periodCount)

  grades        Grade[]
  activities    Activity[] // Módulo Calificaciones
}

model Grade {
  id            String   @id @default(cuid())
  studentId     String
  subjectId     String
  periodId      String
  teacherId     String?
  value         Float    // 0 - 100 o escala institucional
  performance   String?  // bajo, basico, alto, superior
  observations  String?
  isSelfEval    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  period        Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacher       User?    @relation("GradeTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
}

// === Módulo Calificaciones (planilla por actividades, PDF capturas) ===
// Actividad evaluativa: sub-columna N1, N2... de un concepto evaluativo,
// para un grupo+asignatura+periodo. "Act. General" = aplica a todo el grupo.
model Activity {
  id                  String    @id @default(cuid())
  institutionId       String
  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  groupId             String
  group               Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  periodId            String
  period              Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluativeConceptId String
  evaluativeConcept   EvaluativeConcept @relation(fields: [evaluativeConceptId], references: [id], onDelete: Cascade)
  name                String    // "N1", "Taller 1"...
  label               String?   // [UX] título visual en la planilla; null → usar name.
                                // Permite nombre interno único (p.ej. "N1 Saber")
                                // con título por defecto por concepto (p.ej. "N1")
  isGeneral           Boolean   @default(false)
  order               Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  records             GradeRecord[]

  @@unique([groupId, subjectId, periodId, name])
  @@index([groupId, subjectId, periodId])
  @@index([subjectId, periodId, evaluativeConceptId])
}

// Nota de un estudiante en una actividad (escala 0.0 - 5.0).
// PROM / conceptAvg / DEF se calculan al vuelo, NO se persisten.
model GradeRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  value       Float    // 0.0 - 5.0
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, activityId])
  @@index([studentId])
  @@index([activityId])
}

model Workshop {
  id            String   @id @default(cuid())
  institutionId String
  subjectId     String?
  title         String
  description   String?
  level         String?  // grado objetivo
  duration      Int?     // minutos
  attachmentUrl String?
  tags          String?
  createdAt     DateTime @default(now())

  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model Attendance {
  id            String   @id @default(cuid())
  studentId     String
  groupId       String
  date          DateTime
  status        String   // presente, ausente, tarde, excusa
  excuseReason  String?
  recordedById  String?
  notifiedAt    DateTime?
  createdAt     DateTime @default(now())

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recordedBy    User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

model Observation {
  id            String   @id @default(cuid())
  studentId     String
  recordedById  String?
  date          DateTime
  title         String?  // título corto del caso (Gestión de Estudiantes - Convivencia, PDF pág 1)
  category      String   // academico, convivencia, asistencia
  type          String?  // Tipo I, II, III (para convivencia)
  description   String
  severity      String?  // baja, media, alta
  studentReply  String?  // descargos del estudiante
  followUp      String?
  status        String   @default("abierta") // abierta, en_seguimiento, cerrada
  createdAt     DateTime @default(now())

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy    User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

model Orientation {
  id            String   @id @default(cuid())
  studentId     String?
  orientedById  String?
  date          DateTime
  modality      String   // individual, grupal
  reason        String
  notes         String?
  referral      String?  // remisión externa
  followUp      String?
  status        String   @default("abierta")
  createdAt     DateTime @default(now())

  student       Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  orientedBy    User?    @relation(fields: [orientedById], references: [id], onDelete: SetNull)
}

model Meeting {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  type          String   // comité, evaluación, directivo, otro
  date          DateTime
  location      String?
  agenda        String?
  minutes       String?  // acta desarrollada
  signed        Boolean  @default(false)
  signedAt      DateTime?
  signedBy      String?
  hash          String?  // sello criptográfico
  createdAt     DateTime @default(now())

  signers       MeetingSigner[]
}

model MeetingSigner {
  id            String   @id @default(cuid())
  meetingId     String
  userId        String
  signatureData String?  // base64 del canvas
  signedAt      DateTime @default(now())

  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applicantName String
  applicantBirthDate DateTime?
  applicantGrade String  // grado solicitado
  guardianName  String
  guardianPhone String
  guardianEmail String?
  status        String   @default("solicitada") // solicitada, en_revision, aprobada, rechazada, matriculado
  type          String   @default("matricula") // matricula, pre_matricula
  processedById String?
  documentsJson String?  // documentos cargados (JSON)
  notes         String?
  createdAt     DateTime @default(now())

  processedBy   User?    @relation("ProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String   // create, update, delete, login, sign, etc.
  module        String   // modulo afectado
  entityId      String?
  entityType    String?
  details       String?  // JSON
  ip            String?
  hash          String?
  createdAt     DateTime @default(now())
}

// === Comunidad (FluentCommunity-like) ===

model Space {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String?
  type          String   @default("group") // grade, area, committee, parents, project, group
  visibility    String   @default("public") // public, private
  memberCount   Int      @default(0)
  createdAt     DateTime @default(now())

  posts         Post[]
  members       SpaceMember[]
}

model SpaceMember {
  id            String   @id @default(cuid())
  spaceId       String
  userId        String
  role          String   @default("member") // admin, moderator, member
  joinedAt      DateTime @default(now())

  space         Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  spaceId       String?
  authorId      String
  content       String
  attachmentsJson String? // [{type, url, name}]
  pollQuestion  String?
  pollOptionsJson String?
  mentionsJson  String?   // ["@userId"]
  tagsJson      String?
  pinned        Boolean  @default(false)
  edited        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  space         Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  reactions     Reaction[]
}

model Comment {
  id            String   @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?  // para anidados
  content       String
  createdAt     DateTime @default(now())

  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Reaction {
  id            String   @id @default(cuid())
  postId        String
  userId        String
  emoji         String   // like, love, celebrate, insightful
  createdAt     DateTime @default(now())

  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id            String   @id @default(cuid())
  senderId      String
  receiverId    String?
  groupId       String?  // para mensajes grupales
  content       String
  attachmentsJson String?
  readAt        DateTime?
  createdAt     DateTime @default(now())

  sender        User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver      User?    @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // mention, reply, attendance, period_close, vote, system
  title         String
  body          String?
  link          String?
  channel       String   @default("in_app") // in_app, email, sms, push
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Badge {
  id            String   @id @default(cuid())
  name          String
  description   String?
  iconUrl       String?
  criteria      String?
  users         UserBadge[]
}

model UserBadge {
  id            String   @id @default(cuid())
  userId        String
  badgeId       String
  awardedAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge         Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
}

// Operaciones de sincronización offline
model SyncOp {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType    String   // grade, attendance, post, observation
  entityId      String?
  operation     String   // create, update, delete
  payload       String   // JSON
  status        String   @default("pending") // pending, synced, failed
  createdAt     DateTime @default(now())
  syncedAt      DateTime?
}

// ============================================================
// MÓDULOS PERSONALIZADOS (constructor estilo FluentForms)
// ============================================================

model CustomModule {
  id              String   @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?
  icon            String   @default("FileText") // nombre de icono lucide
  area            String   @default("Personalizado") // Académico, Convivencia, Comunidad, Administración, Personalizado
  menuLabel       String?
  tabOrientation  String   @default("horizontal") // horizontal, vertical
  tabLabelsJson   String   @default("[\"Registros\",\"Nuevo\"]") // etiquetas de los 2 tabs
  fieldsJson      String   // JSON con definición de campos (ver docs)
  settingsJson    String?  // configuración extra: mensajes, notificaciones, etc.
  successMessage  String   @default("Registro enviado correctamente.")
  errorMessage    String   @default("Ocurrió un error. Verifique los datos.")
  published       Boolean  @default(false) // el rector debe aprobar
  publishedAt     DateTime?
  publishedById   String?
  status          String   @default("draft") // draft, pending_review, published, rejected
  rejectionReason String?
  visibleRolesJson    String @default("[\"docente\",\"director_grupo\",\"coordinador\",\"rector\",\"orientador\",\"acudiente\",\"estudiante\",\"administrativo\"]")
  canCreateRolesJson  String @default("[\"docente\",\"director_grupo\",\"coordinador\",\"rector\",\"orientador\",\"acudiente\",\"estudiante\",\"administrativo\"]")
  canEditRolesJson    String @default("[\"rector\",\"administrativo\"]")
  canDeleteRolesJson  String @default("[\"rector\",\"administrativo\"]")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  records         CustomModuleRecord[]
  @@unique([institutionId, slug])
}

model CustomModuleRecord {
  id            String   @id @default(cuid())
  moduleId      String
  module        CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userId        String?  // quien creó el registro
  dataJson      String   // JSON con los valores del formulario
  status        String   @default("submitted") // submitted, reviewed, approved, rejected
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([moduleId])
  @@index([institutionId])
}

// ============================================================
// MÓDULOS DE PARÁMETROS DEL SISTEMA (según PDF)
// ============================================================

// --- Año académico (PDF pág 1-2) ---
model AcademicYear {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  year          Int      // 2025, 2026, 2027...
  decree        String?  // Decreto (PDF pág 2)
  startDate     DateTime?
  endDate       DateTime?
  active        Boolean  @default(false)  // Solo un año activo por institución
  closed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  evalModels    EvaluationModel[]
  groups        Group[]
  studentEnrollments StudentEnrollment[]

  @@unique([institutionId, year])
}

// --- Escala valorativa (PDF pág 6-8) ---
// Bajo, Básico, Alto, Superior - con rango numérico
model EvaluationScale {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // Bajo, Básico, Alto, Superior
  minValue      Float    // 0.0
  maxValue      Float    // 2.9
  color         String?  // chip-bajo, chip-basico, chip-alto, chip-superior
  sortOrder     Int      @default(0)  // Bajo=1, Básico=2, Alto=3, Superior=4
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  adjectives    IndicatorAdjective[]
  evalModels    EvaluationModel[]

  @@unique([institutionId, name])
}

// --- Adjetivos para indicadores (PDF pág 6-8) ---
// Adjetivos como "Difícilmente", "Algunas veces", "Frecuentemente", "Siempre"
// asociados a una escala valorativa
model IndicatorAdjective {
  id            String   @id @default(cuid())
  institutionId String
  scaleId       String
  scale         EvaluationScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  name          String   // "Difícilmente", "Algunas veces", etc.
  createdAt     DateTime @default(now())

  @@unique([scaleId, name])
}

// --- Modelos evaluativos (PDF pág 9-12) — DEPRECADO [C3] ---
// Módulo eliminado del sistema (menú/vista/API). Su función la cumple
// "Escalas valorativas" (EvaluationScale). Tabla y datos conservados
// intencionalmente; no eliminar sin decisión explícita de negocio.
// Combinación año + escala + notas mín/máx
model EvaluationModel {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  scaleId       String
  scale         EvaluationScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  minNote       Float    // Nota mínima (ej: 4.5)
  maxNote       Float    // Nota máxima (ej: 5.0)
  createdAt     DateTime @default(now())

  @@unique([institutionId, academicYearId, scaleId])
}

// --- Modelos educativos / pedagógicos (PDF: Conceptos evaluativos) ---
// Modelos como "Escuela nueva", "Educación tradicional", etc.
model EducationalModel {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // "Escuela nueva", "Educación tradicional", ...
  active        Boolean  @default(true)
  periodCount   Int      @default(4) // cantidad de periodos académicos del modelo
  details       String?  // HTML del editor rich text (Tiptap)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  concepts      EvaluativeConcept[]
  periods       Period[]
  studyPlans    CurriculumPlan[]

  @@unique([institutionId, name])
}

// --- Conceptos evaluativos (PDF: Conceptos evaluativos) ---
// Conceptos como Ser, Saber, Hacer, Autoevaluación con porcentaje por modelo.
// La misma estructura puede repetirse entre distintos modelos (patrón del dominio).
model EvaluativeConcept {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  educationalModelId String
  educationalModel EducationalModel @relation(fields: [educationalModelId], references: [id], onDelete: Cascade)
  name          String   // "Ser", "Saber", "Hacer", "Autoevaluación" (nombre libre)
  percentage    Int      // 0-100
  order         Int      @default(0) // posición dentro del modelo educativo
  open          Boolean  @default(true) // Estado: Abierto (true) / Cerrado (false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activities    Activity[] // Módulo Calificaciones

  @@unique([educationalModelId, name])
}

// --- Sedes (PDF pág 19-21) ---
model Branch {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // "Principal", "Sede B", etc.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  groups        Group[]

  @@unique([institutionId, name])
}

// --- Jornadas (PDF pág 22-24) ---
model Journey {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // "Mañana", "Tarde", "Única", "Nocturna", etc.
  educationalModelsJson String?  // JSON array: ["Educación tradicional", "Escuela nueva", ...]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  groups        Group[]

  @@unique([institutionId, name])
}

// --- Plantillas de reportes (PDF pág 16-18) ---
// Constancia de estudio, Certificado periódico, Informe valorativo
model ReportTemplate {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // "Constancia de estudio", "Certificado periódico"
  slug          String   // constancia_estudio, certificado_periodico
  type          String   @default("constancia")  // constancia, certificado, informe_valorativo
  headerHtml    String?  // HTML del encabezado (editor WYSIWYG)
  bodyHtml      String?  // HTML del cuerpo
  footerHtml    String?  // HTML del pie
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variables     ReportVariable[]

  @@unique([institutionId, slug])
}

// --- Variables de reporte (PDF pág 15) ---
// Variables dinámicas para informes valorativos: {{nombre_estudiante}}, {{fecha}}, etc.
model ReportVariable {
  id            String   @id @default(cuid())
  reportTemplateId String
  reportTemplate ReportTemplate @relation(fields: [reportTemplateId], references: [id], onDelete: Cascade)
  variable      String   // "nombre_estudiante", "fecha", "promedio"
  value         String   // Valor por defecto o fórmula
  description   String?
  createdAt     DateTime @default(now())

  @@unique([reportTemplateId, variable])
}

// ============================================================
// PLAN DE ESTUDIOS (normalizado)
// Áreas y grados como catálogos (eliminan texto libre redundante),
// planes de estudios y su detalle asignatura × grado con intensidad horaria.
// ============================================================

// --- Áreas del conocimiento (catálogo, normaliza Subject.area) ---
model KnowledgeArea {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // "Ciencias Naturales", "Humanidades"...
  abbreviation  String?  // "C.NAT", "HUM"...
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subjects      Subject[] @relation("SubjectArea")

  @@unique([institutionId, name])
}

// --- Grados (catálogo, normaliza Group.grade) ---
model GradeLevel {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String   // "PJ", "J", "T", "1"..."11" — clave corta
  name          String   // "Prejardín", "Grado 6°"...
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  groups        Group[]
  planItems     CurriculumPlanItem[]

  @@unique([institutionId, code])
}

// --- Plan de estudios (encabezado) ---
// La estructura se preserva entre años (PDF pág 1: al crear el siguiente
// año se copia la misma estructura de grupos, periodos y plan de estudio).
model CurriculumPlan {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String   // "Plan de estudios 2026", "Plan básica secundaria"...
  description   String?
  educationalModelId String
  educationalModel EducationalModel @relation(fields: [educationalModelId], references: [id], onDelete: Restrict)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         CurriculumPlanItem[]

  @@unique([institutionId, name])
  @@index([educationalModelId])
}

// --- Detalle del plan: asignatura × grado con intensidad horaria ---
model CurriculumPlanItem {
  id            String   @id @default(cuid())
  planId        String
  plan          CurriculumPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevelId  String
  gradeLevel    GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  weeklyHours   Float    @default(1)  // intensidad horaria semanal
  sortOrder     Int      @default(0)  // orden en boletín / planilla
  createdAt     DateTime @default(now())

  @@unique([planId, subjectId, gradeLevelId])
  @@index([planId])
  @@index([subjectId])
  @@index([gradeLevelId])
}

// ============================================================
// GESTIÓN DE USUARIOS (normalizado)
// Roles como catálogo por institución + relación N:M usuario↔rol.
// Elimina la redundancia del rol como texto libre de cardinalidad 1:1
// (un usuario puede ejercer varios roles; PDF módulo Usuarios).
// ============================================================

// --- Catálogo de roles por institución ---
model Role {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String   // rector, coordinador, docente, tesoreria...
  name          String   // "Rectoría", "Docente", "Tesorería"...
  description   String?
  sortOrder     Int      @default(0)  // orden en el modal de roles; el menor define el rol principal
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  users         UserRole[]

  @@unique([institutionId, code])
}

// --- Unión usuario ↔ rol (soporta múltiples roles por usuario) ---
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

// === Gestión de Estudiantes (PDF Módulo Gestionar Estudiante) ===
// Matrícula por año del estudiante (fichas por folio, renovaciones).
// Nota: `Enrollment` (línea ~317) son solicitudes de admisión — semántica distinta.
model StudentEnrollment {
  id              String    @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  groupId         String?
  group           Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status          String    @default("matriculado") // matriculado, renovado, retirado, sin_formalizar
  libro           Int?      // libro de matrícula (PDF pág 5/11)
  folio           Int?      // folio (PDF pág 5/11)
  code            String?   // código de matrícula — DEPRECADO, solo lectura (PDF pág 5/11)
  enrolledAt      DateTime? // fecha de matrícula
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  events          EnrollmentEvent[]

  @@index([institutionId, academicYearId])
  @@index([studentId])
}

// Novedades de matrícula (retiro, traslado, repitente...) — PDF pág 11
model EnrollmentEvent {
  id            String   @id @default(cuid())
  enrollmentId  String
  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type          String   // retiro, traslado, repitente, nuevo, otra
  reason        String?  // motivo
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([enrollmentId])
}

// Contactos familiares del estudiante — PDF pág 6/12
model StudentContact {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName      String
  relationship  String   // madre, padre, acudiente, otro
  phone         String?
  email         String?
  occupation    String?  // ocupación (PDF pág 12)
  isPrimary     Boolean  @default(false) // badge "Principal" (PDF pág 12)
  createdAt     DateTime @default(now())

  @@index([studentId])
}

// Checklist de requisitos pendientes de matrícula — PDF pág 7
model StudentRequirement {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name          String   // nombre del requisito
  notes         String?  // descripción/detalle opcional
  fulfilled     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([studentId])
}

// Certificados de otras instituciones — PDF pág 8
model ExternalCertificate {
  id              String   @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  year            Int      // año del certificado
  gradeLevel      String?  // grado (texto, ej. "5°")
  institutionName String   // establecimiento educativo
  city            String?
  observation     String?
  fileName        String?  // nombre del archivo adjunto
  fileType        String?  // pdf, jpg, png
  fileData        String?  // contenido como data URL (base64)
  createdAt       DateTime @default(now())

  @@index([studentId])
}
